{
  "name": "front-standard",
  "displayName": "AIDDbot Archetypes",
  "version": "0.2.0",
  "description": "Standard web client — framework-free HTML/CSS/TS.",
  "keywords": [
    "archetype",
    "frontend",
    "html",
    "starter",
    "vanilla"
  ],
  "homepage": "https://aiddbot.com",
  "license": "MIT",
  "author": {
    "name": "Alberto Basalo",
    "email": "albertobasalo@aicode.academy",
    "url": "https://aicode.academy"
  },
  "repository": {
    "url": "https://github.com/AIDDbot/front-standard"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server/main.ts",
    "start": "node src/server/main.ts",
    "test": "node --import ./test-setup.ts --test \"src/**/*.test.ts\"",
    "test:watch": "node --watch --import ./test-setup.ts --test \"src/**/*.test.ts\"",
    "lint": "oxlint --format=agent --quiet",
    "lint:fix": "oxlint --fix --format=agent --quiet",
    "format": "oxfmt --write",
    "fix": "node --run lint:fix && node --run format",
    "quality:warnings": "oxlint --deny-warnings --format=agent",
    "quality:complexity": "oxlint -c .oxlintrc.complexity.json --format=agent --quiet",
    "quality:coverage": "node --input-type=module -e \"import { mkdirSync } from 'node:fs'; mkdirSync('coverage', { recursive: true });\" && node --import ./test-setup.ts --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"**/*.config.*\" --test-coverage-exclude=\"**/generated/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"src/**/*.test.ts\"",
    "quality:all": "node --run quality:warnings && node --run quality:complexity && node --run quality:coverage"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2"
  },
  "config": {
    "codename": "oktoberfest"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "npm@12.0.0"
}
