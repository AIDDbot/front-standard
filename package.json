{
  "name": "front-standard",
  "version": "1.0.0",
  "description": "Standard web client — framework-free HTML/CSS/TS.",
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts",
    "start": "bun server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "oxlint --fix --quiet --format=agent ",
    "lint:warnings": "oxlint --deny-warnings --format=agent ",
    "lint:complexity": "oxlint --quiet -D complexity --format=agent"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "7"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=26.0.0",
    "bun": ">=1.4.0"
  }
}