{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "eslint", "oxc"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "style": "off"
  },
  "rules": {
    "eslint/one-var": ["error", "never"],
    "eslint/sort-imports": "off",
    "eslint/sort-vars": "off",
    "@typescript-eslint/strict-boolean-expressions": "off",
    "@typescript-eslint/prefer-readonly-parameter-types": "off"
  },
  "overrides": [
    {
      "files": ["src/app/router/*/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./[^.]",
                "message": "Pages must not import from other pages; promote shared code to src/app/shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/shared/**/*.ts", "src/app/core/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "/router/",
                "message": "shared and core must not depend on router."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts"],
      "rules": {
        "@typescript-eslint/prefer-readonly-parameter-types": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-assignment": "off",
        "unicorn/no-useless-undefined": "off",
        "oxc/approx-constant": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
